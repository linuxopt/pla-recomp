From 99fdab0d302489bdf9e794a0f117871d750669ce Mon Sep 17 00:00:00 2001
From: linuxopt <305337987+linuxopt@users.noreply.github.com>
Date: Tue, 10 Nov 2026 20:10:18 -0500
Subject: [PATCH] Setup from the picked base game, update and prod.keys; 1.1.1
 check; paths saved

setup_start_files opens exactly the three picked files (nxpkg_open_files).
Anything that isn't Legends: Arceus 1.1.1 (main build id aee8f150dda1b5a8) is
refused with SETUP_FAIL_GAME_VERSION before the old game files are removed.
larecomp.ini keeps the picked paths (setup_base / setup_update / setup_keys).
---
 runtime/gamesetup.c | 59 ++++++++++++++++++++++++++++++++++++++++-----
 runtime/gamesetup.h |  6 +++++
 runtime/settings.c  | 23 ++++++++++++------
 runtime/settings.h  |  2 ++
 4 files changed, 76 insertions(+), 14 deletions(-)

diff --git a/runtime/gamesetup.c b/runtime/gamesetup.c
index 5dbd10c..83bfdc4 100644
--- a/runtime/gamesetup.c
+++ b/runtime/gamesetup.c
@@ -37,6 +37,8 @@ static _Atomic int g_state;
 static _Atomic float g_progress;
 static _Atomic bool g_running;
 static char g_folder[1024];
+static char g_files[3][1024];  // setup_start_files: base game, update, prod.keys (g_folder empty)
+static bool g_from_files;
 
 int setup_state(void) { return g_state; }
 float setup_progress(void) { return g_progress; }
@@ -66,6 +68,20 @@ static uint64_t program_id(const char *exefs) {
     return id;
 }
 
+static const uint8_t PLA_111[8] = {0xae, 0xe8, 0xf1, 0x50, 0xdd, 0xa1, 0xb5, 0xa8};  // Legends: Arceus 1.1.1 main
+
+bool game_is_pla_111(const char *exefs) {
+    char p[1100];
+    snprintf(p, sizeof p, "%s/main", exefs);
+    FILE *f = fopen(p, "rb");
+    if (!f) return false;
+    uint8_t id[8] = {0};
+    fseek(f, 0x40, SEEK_SET);  // (NSO header: the module id)
+    size_t n = fread(id, 1, 8, f);
+    fclose(f);
+    return n == 8 && !memcmp(id, PLA_111, 8) && program_id(exefs) == TITLE_PLA;
+}
+
 static bool game_ok(const char *exefs) {
     uint64_t id = program_id(exefs);
     return id == TITLE_EEVEE || id == TITLE_PIKACHU || id == TITLE_PLA;
@@ -181,9 +197,11 @@ static bool from_packages(void) {
     int err;
     char why[512] = "";
     g_state = SETUP_UNPACKING;
-    NxPkg *p = nxpkg_open(g_folder, titles, &err, why, sizeof why);
+    const char *pkgs[2] = {g_files[0], g_files[1]};
+    NxPkg *p = g_from_files ? nxpkg_open_files(pkgs, 2, g_files[2], titles, &err, why, sizeof why)
+                            : nxpkg_open(g_folder, titles, &err, why, sizeof why);
     if (!p) {
-        LOG("[setup] packages in %s: %s\n", g_folder, why);
+        LOG("[setup] packages in %s: %s\n", g_from_files ? g_files[0] : g_folder, why);
         g_state = err == NXPKG_NO_KEYS ? SETUP_FAIL_KEYS : err == NXPKG_KEY_MISSING ? SETUP_FAIL_KEYS_OLD
                 : err == NXPKG_ONLY_UPDATE ? SETUP_FAIL_NO_BASE : err == NXPKG_COMPRESSED ? SETUP_FAIL_PACKAGE
                 : err == NXPKG_NO_GAME ? SETUP_FAIL_VERSION : SETUP_FAIL_UNPACK;
@@ -211,6 +229,13 @@ static bool from_packages(void) {
         nxpkg_close(p);
         return false;
     }
+    if (!game_is_pla_111(UNPACK_TMP "/exefs")) {  // (before the old game files go: a wrong update keeps the old setup)
+        LOG("[setup] %s v%u: not Legends: Arceus 1.1.1\n", pick ? "update" : "base game", nxpkg_update_version(p, pick));
+        g_state = SETUP_FAIL_GAME_VERSION;
+        plat_remove_tree(UNPACK_TMP);
+        nxpkg_close(p);
+        return false;
+    }
     rt_remove_game_files(ROOT);  // (an earlier or interrupted setup's)
     mkdir(ROOT, 0755);
     bool ok = rename(UNPACK_TMP "/exefs", ROOT "/exefs") == 0;
@@ -245,6 +270,12 @@ static bool build_code(void) {
 static void *setup_thread(void *arg) {
     (void)arg;
     g_progress = 0;
+    if (g_from_files) {  // (the picked base game, update and prod.keys)
+        if (from_packages() && build_code()) g_state = setup_ready() ? SETUP_DONE : SETUP_FAIL_BUILD;
+        LOG("[setup] %s\n", g_state == SETUP_DONE ? "ready" : "failed");
+        g_running = false;
+        return NULL;
+    }
     if (!g_folder[0]) {  // only the game code (files set up already, e.g. a new version of the app)
         if (build_code()) g_state = setup_ready() ? SETUP_DONE : SETUP_FAIL_BUILD;
         g_running = false;
@@ -264,6 +295,7 @@ static void *setup_thread(void *arg) {
         }
         g_state = SETUP_FAIL_NOT_FOUND;
     } else if (!game_ok(f.exefs)) g_state = SETUP_FAIL_VERSION;
+    else if (!game_is_pla_111(f.exefs)) g_state = SETUP_FAIL_GAME_VERSION;
     else {
         // (the picked folder can't be our own copy: setting up again deletes that first)
         char a[4096], b[4096];
@@ -306,13 +338,28 @@ static void *setup_thread(void *arg) {
     return NULL;
 }
 
-void setup_start(const char *folder) {
-    if (g_running) return;
-    snprintf(g_folder, sizeof g_folder, "%s", folder ? folder : "");
-    for (char *c = g_folder; *c; c++) if (*c == '\\') *c = '/';
+static void start_thread(void) {
     g_running = true;
     g_state = SETUP_LOOKING;
     pthread_t t;
     pthread_create(&t, NULL, setup_thread, NULL);
     pthread_detach(t);
 }
+
+void setup_start_files(const char *base, const char *update, const char *keys) {
+    if (g_running) return;
+    g_folder[0] = 0;
+    snprintf(g_files[0], sizeof g_files[0], "%s", base ? base : "");
+    snprintf(g_files[1], sizeof g_files[1], "%s", update ? update : "");
+    snprintf(g_files[2], sizeof g_files[2], "%s", keys ? keys : "");
+    g_from_files = true;
+    start_thread();
+}
+
+void setup_start(const char *folder) {
+    if (g_running) return;
+    g_from_files = false;
+    snprintf(g_folder, sizeof g_folder, "%s", folder ? folder : "");
+    for (char *c = g_folder; *c; c++) if (*c == '\\') *c = '/';
+    start_thread();
+}
diff --git a/runtime/gamesetup.h b/runtime/gamesetup.h
index 5568b09..ac0d866 100644
--- a/runtime/gamesetup.h
+++ b/runtime/gamesetup.h
@@ -31,6 +31,7 @@ enum {
     SETUP_FAIL_KEYS_OLD,    // the keys can't open them (older than the game, or no ticket / title key)
     SETUP_FAIL_NO_BASE,     // the update's package without the base game's
     SETUP_FAIL_UNPACK,      // a package couldn't be read (damaged, or a layout runtime/nxpkg.c doesn't read)
+    SETUP_FAIL_GAME_VERSION,  // Legends: Arceus, but not update 1.1.1 (the only build tools/patches.py knows)
 };
 
 // The game files in <data root>/extracted: ready to play (exefs, romfs.bin and game code built for this version).
@@ -45,6 +46,11 @@ int game_build(const char *exefs);
 const char *game_version(const char *exefs);
 // Starts a setup from the picked folder (NULL: only rebuild the game code from files set up already).
 void setup_start(const char *folder);
+// Starts a setup from the picked files: the base game's .nsp / .xci, its update's .nsp and the prod.keys to open them
+// with (runtime/nxpkg.c nxpkg_open_files). The game files set up before stay until the new ones are checked.
+void setup_start_files(const char *base, const char *update, const char *keys);
+// That exefs/ is Pokémon Legends: Arceus 1.1.1 (its program id, and its main's build id aee8f150dda1b5a8).
+bool game_is_pla_111(const char *exefs);
 int setup_state(void);         // SETUP_*
 float setup_progress(void);    // 0..1 while running
 bool setup_running(void);
diff --git a/runtime/settings.c b/runtime/settings.c
index 0bc8f88..ee28dd8 100644
--- a/runtime/settings.c
+++ b/runtime/settings.c
@@ -1,5 +1,6 @@
 #include "settings.h"
 
+#include <stddef.h>
 #include <stdio.h>
 #include <stdlib.h>
 #include <string.h>
@@ -45,14 +46,18 @@ static void parse_line(const char *line) {
     char key[64];
     char val[1024];  // (mod: several names)
     if (sscanf(line, " %63[^= ] = %1023[^\n]", key, val) < 1) return;
-    if (!strcmp(key, "game_lang") || !strcmp(key, "mod") || !strcmp(key, "plugins_off") || !strcmp(key, "plugins_on")) {  // (may be empty)
-        if (sscanf(line, " %63[^= ] = %1023[^\n]", key, val) != 2) val[0] = 0;
-        if (key[0] == 'g') strlcpy(g_settings.game_lang, val, sizeof g_settings.game_lang);
-        else if (!strcmp(key, "plugins_off")) strlcpy(g_settings.plugins_off, val, sizeof g_settings.plugins_off);
-        else if (key[0] == 'p') strlcpy(g_settings.plugins_on, val, sizeof g_settings.plugins_on);
-        else strlcpy(g_settings.mod, val, sizeof g_settings.mod);
-        return;
-    }
+    static const struct { const char *key; size_t off, size; } text[] = {  // (values that may be empty)
+#define TEXT(k, f) {k, offsetof(Settings, f), sizeof g_settings.f}
+        TEXT("game_lang", game_lang), TEXT("mod", mod), TEXT("plugins_off", plugins_off), TEXT("plugins_on", plugins_on),
+        TEXT("setup_base", setup_base), TEXT("setup_update", setup_update), TEXT("setup_keys", setup_keys),
+#undef TEXT
+    };
+    for (size_t i = 0; i < sizeof text / sizeof *text; i++)
+        if (!strcmp(key, text[i].key)) {
+            if (sscanf(line, " %63[^= ] = %1023[^\n]", key, val) != 2) val[0] = 0;
+            strlcpy((char *)&g_settings + text[i].off, val, text[i].size);
+            return;
+        }
     if (!strcmp(key, "fullscreen")) g_settings.fullscreen = atoi(val) != 0;
     else if (!strcmp(key, "fps")) { int f = atoi(val); g_settings.fps = f == 60 || f == 72 || f == 120 || f == 144 || f == FPS_UNLIMITED ? f : 30; }
     else if (!strcmp(key, "experimental")) g_settings.experimental = atoi(val) != 0, g_experimental_seen = true;
@@ -145,6 +150,8 @@ void settings_save(void) {
     fprintf(f, "mod = %s\n", g_settings.mod);
     fprintf(f, "plugins_off = %s\n", g_settings.plugins_off);
     fprintf(f, "plugins_on = %s\n", g_settings.plugins_on);
+    fprintf(f, "setup_base = %s\nsetup_update = %s\nsetup_keys = %s\n", g_settings.setup_base, g_settings.setup_update,
+            g_settings.setup_keys);
     fprintf(f, "mouse_sens = %.3f\n", g_settings.mouse_sens);
     fprintf(f, "stick_deadzone = %.2f\n", g_settings.stick_deadzone);
     fprintf(f, "volume = %.2f\n", g_settings.volume);
diff --git a/runtime/settings.h b/runtime/settings.h
index 2f70194..5740d68 100644
--- a/runtime/settings.h
+++ b/runtime/settings.h
@@ -51,6 +51,8 @@ typedef struct {
     char mod[1024];      // the mods that are on (mods/<name>/), in load order, separated by commas; empty = none (runtime/mods.h)
     char plugins_off[256];  // plugins/ files left out, comma-separated (runtime/plugin.c)
     char plugins_on[256];   // ... and the opt-in ones switched on ("steamrelay.dll"; plugin_opt_in)
+    char setup_base[1024], setup_update[1024], setup_keys[1024];  // the start screen's picked game files (base game,
+                                                                  // update, prod.keys: runtime/gamesetup.h setup_start_files)
     int next_fps, next_res_height;  // set in game (hle/pla_options.c; the height + 1), 0 = not: for the ini, from the next start
 } Settings;
 
-- 
2.56.0

