From ec23e5906567e28da9a9027a3a21439a558a1eff Mon Sep 17 00:00:00 2001
From: linuxopt <305337987+linuxopt@users.noreply.github.com>
Date: Tue, 10 Nov 2026 20:12:04 -0500
Subject: [PATCH] Launcher: base game, update and prod.keys pickers

Game Files: one row per file (Browse...), Recompile once all three exist,
prod.keys pre-filled from the usual places, each failure under the row it is
about. The extracted-dump folder picker stays as a small link.
---
 runtime/ui/launcher_lg.mm | 176 ++++++++++++++++++++++++++++----------
 1 file changed, 129 insertions(+), 47 deletions(-)

diff --git a/runtime/ui/launcher_lg.mm b/runtime/ui/launcher_lg.mm
index 97cc1c2..884a70f 100644
--- a/runtime/ui/launcher_lg.mm
+++ b/runtime/ui/launcher_lg.mm
@@ -37,6 +37,7 @@ extern "C" {
 #include "gamesetup.h"
 #include "input_bind.h"
 #include "mods.h"
+#include "nxpkg.h"
 #include "platform.h"
 #include "plugin.h"
 #include "paths.h"
@@ -429,73 +430,152 @@ static bool take(char *slot, char *out, size_t n) {
 // ------------------------------------------------------------------ the game files section
 static const ImVec4 k_green(0.45f, 0.85f, 0.50f, 1), k_red(1.0f, 0.45f, 0.40f, 1), k_yellow(1.0f, 0.82f, 0.35f, 1);
 
