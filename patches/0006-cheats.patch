@@ -497,6 +498,125 @@ static void fail_text(int st) {
         ImGui::PopTextWrapPos();
 }
 
+// ------------------------------------------------------------------ the Mods page's Cheats tab (patches/0006)
+// Atmosphère cheat files (<build id>.txt, or a cheat database's zip): imported into <data>/cheats, each cheat on or
+// off (runtime/cheats.c); the game runs the ones that are on every frame (hle/cheats_rt.c), from its next start.
+static char g_pick_cheat[1024];
+static void SDLCALL picked_cheat(void *, const char *const *files, int) {
+    if (!files || !files[0]) return;
+    pthread_mutex_lock(&g_pick_lock);
+    snprintf(g_pick_cheat, sizeof g_pick_cheat, "%s", files[0]);
+    pthread_mutex_unlock(&g_pick_lock);
+}
+// main's code, as offsets from its base: the NSO header's text segment (memory offset +0x14, size +0x18)
+static bool main_text(const char *exefs, uint64_t *lo, uint64_t *hi) {
+    char p[1100];
+    snprintf(p, sizeof p, "%s/main", exefs);
+    FILE *f = fopen(p, "rb");
+    if (!f) return false;
+    uint8_t h[0x1C];
+    bool ok = fread(h, 1, sizeof h, f) == sizeof h && !memcmp(h, "NSO0", 4);
+    fclose(f);
+    if (!ok) return false;
+    uint32_t off, size;
+    memcpy(&off, h + 0x14, 4), memcpy(&size, h + 0x18, 4);
+    *lo = off, *hi = (uint64_t)off + size;
+    return true;
+}
+static void cheats_section(SDL_Window *win) {
+    static const SDL_DialogFileFilter filters[] = {{"Cheats (.txt, .zip)", "txt;zip"}, {"All files", "*"}};
+    static const char *const ex = "extracted/exefs";
+    static CheatList list;
+    static std::vector<char> on, code;  // (per cheat: on; patches the game's code)
+    static bool stale = true, msg_bad;
+    static char msg[320];
+    char bid[17], picked[1024];
+    bool have_game = cheats_build_id(ex, bid);
+    pthread_mutex_lock(&g_pick_lock);
+    snprintf(picked, sizeof picked, "%s", g_pick_cheat);
+    g_pick_cheat[0] = 0;
+    pthread_mutex_unlock(&g_pick_lock);
+    if (picked[0]) {
+        char why[256];
+        msg_bad = !cheats_import(picked, ex, why, sizeof why);
+        if (msg_bad) snprintf(msg, sizeof msg, "%s", why);
+        else snprintf(msg, sizeof msg, "%s", T("Cheats imported. Tick the ones you want: they work from the game's next start.",
+                                               "Cheats importados. Marque os que quiser: eles valem a partir do próximo início do jogo."));
+        stale = true;
+    }
+    if (stale) {
+        stale = false;
+        cheats_free(&list);
+        on.clear(), code.clear();
+        uint64_t lo = 0, hi = 0;
+        bool text = have_game && main_text(ex, &lo, &hi);
+        if (have_game && cheats_load(ex, &list) > 0)
+            for (int i = 0; i < list.n; i++) {
+                on.push_back(cheats_is_on(ex, list.c[i].name));
+                code.push_back(text && cheat_patches_code(&list.c[i], lo, hi));
+            }
