From cd6ed0212c64cbddf585351940c8813a9c86d293 Mon Sep 17 00:00:00 2001
From: linuxopt <305337987+linuxopt@users.noreply.github.com>
Date: Tue, 10 Nov 2026 22:36:29 -0500
Subject: [PATCH] Code cheats: instruction writes compiled in as switchable
 variants

A recompiled game can't run rewritten instructions from memory, so a cheat that
patches main's code did nothing. Now every fixed instruction write in the
imported cheat file (any cheat, on or off) is listed (cheats/<build
id>.variants.json, made at import and by cheats_prepare for a file copied in)
and the generator compiles each word next to the original instruction
(gen.py --code-variants, through the randomizer's RANDO_CODE path: a word the
lifter can't translate is left out and said). rando_word picks the word on at
run time; the cheat VM's write into main's code switches a compiled-in variant
on (CheatEnv.code_write) instead of being refused. The game library records
the list it was built with (lasgame.so.variants); a different cheat file makes
the game code be built again (setup_needs_code), and the Cheats tab offers the
rebuild. Code cheats then toggle like any other.
---
 runtime/cheats.c          | 186 +++++++++++++++++++++++++++++++++++++-
 runtime/cheats.h          |  34 +++++++
 runtime/gamebuild.c       |  24 +++++
 runtime/gamesetup.c       |  16 +++-
 runtime/hle/cheats_rt.c   |  17 +++-
 runtime/paths.c           |   2 +-
 runtime/ui/launcher_lg.mm |  68 ++++++++------
 tools/gen.py              |  39 ++++++++
 8 files changed, 353 insertions(+), 33 deletions(-)

diff --git a/runtime/cheats.c b/runtime/cheats.c
index 297b369..07f16c1 100644
--- a/runtime/cheats.c
+++ b/runtime/cheats.c
@@ -27,7 +27,10 @@ static uint64_t mem_read(const CheatEnv *e, uint64_t a, unsigned w, int *res) {
     return v;
 }
 static void mem_write(const CheatEnv *e, uint64_t a, unsigned w, uint64_t v, int *res) {
-    if (!e->writable || !e->writable(a, w)) { *res |= CHEAT_WRITE_BLOCKED; return; }
+    if (!e->writable || !e->writable(a, w)) {
+        if (!(e->code_write && e->code_write(a, &v, w))) *res |= CHEAT_WRITE_BLOCKED;  // (a code cheat's variant: taken)
+        return;
+    }
     memcpy((void *)(uintptr_t)a, &v, w);
 }
 static uint64_t base_of(const CheatEnv *e, unsigned m) { return m < 4 ? e->base[m] : 0; }
@@ -366,6 +369,81 @@ bool cheat_patches_code(const Cheat *c, uint64_t code_lo, uint64_t code_hi) {
     return false;
 }
 
+int cheats_code_variants(const CheatList *l, uint64_t code_lo, uint64_t code_hi, CheatVariant *out, int max) {
+    int n = 0;
+    for (int i = 0; i < l->n; i++) {
+        const Cheat *c = &l->c[i];
+        for (int pc = 0; pc < c->nop;) {
+            int len = op_len(c->op, c->nop, pc);
+            if (len == 0) break;
+            uint32_t f = c->op[pc];
+            unsigned w = (f >> 24) & 0xF, m = (f >> 20) & 0xF, r = (f >> 16) & 0xF;
+            if (f >> 28 == 0 && m == CHEAT_MAIN && r == 0 && (w == 4 || w == 8)) {  // (a fixed write, no offset register)
+                uint64_t a = (uint64_t)(f & 0xFF) << 32 | c->op[pc + 1];
+                uint64_t v = w == 8 ? (uint64_t)c->op[pc + 2] << 32 | c->op[pc + 3] : c->op[pc + 2];
+                for (unsigned k = 0; k < w / 4; k++) {
+                    uint64_t off = a + 4 * k;
+                    uint32_t word = (uint32_t)(v >> (32 * k));
+                    if (off < code_lo || off >= code_hi || (off & 3)) continue;
+                    bool seen = false;
+                    for (int j = 0; j < n && !seen; j++) seen = out[j].off == off && out[j].word == word;
+                    if (!seen && n < max) out[n++] = (CheatVariant){off, word};
+                }
+            }
+            pc += len;
+        }
+    }
+    return n;
+}
+
+// ---- the variants compiled into the running game code: an open-addressed table by address
+#define CODE_SITES 4096
+#define CODE_WORDS 8  // (variants at one address, at most)
+static struct {
+    uint64_t addr;
+    int n;
+    uint32_t word[CODE_WORDS];
+    uint32_t on;  // (atomic: the cheat VM writes it, the game's threads read it - rando_word)
+} g_code[CODE_SITES];
+static unsigned site_slot(uint64_t a) { return (unsigned)((a >> 2) * 0x9E3779B1u) & (CODE_SITES - 1); }
+static int site_find(uint64_t a, bool make) {
+    for (unsigned s = site_slot(a), k = 0; k < CODE_SITES; k++, s = (s + 1) & (CODE_SITES - 1)) {
+        if (g_code[s].addr == a) return (int)s;
+        if (!g_code[s].addr) {
+            if (!make) return -1;
+            g_code[s].addr = a, g_code[s].n = 0, g_code[s].on = CHEAT_CODE_ORIGINAL;
+            return (int)s;
+        }
+    }
+    return -1;
+}
+void cheat_code_reset(void) { memset(g_code, 0, sizeof g_code); }
+bool cheat_code_add(uint64_t a, uint32_t word) {
+    if (!a || (a & 3)) return false;
+    int s = site_find(a, true);
+    if (s < 0) return false;
+    for (int i = 0; i < g_code[s].n; i++) if (g_code[s].word[i] == word) return true;
+    if (g_code[s].n == CODE_WORDS) return false;
+    g_code[s].word[g_code[s].n++] = word;
+    return true;
+}
+bool cheat_code_write(uint64_t a, const void *v, unsigned n) {
+    if ((a & 3) || !n || (n & 3) || n > 8) return false;
+    int site[2];
+    for (unsigned k = 0; k < n / 4; k++) if ((site[k] = site_find(a + 4 * k, false)) < 0) return false;
+    for (unsigned k = 0; k < n / 4; k++) {
+        uint32_t w, on = CHEAT_CODE_ORIGINAL;  // (a word that isn't compiled in - the original, restored: the game's)
+        memcpy(&w, (const uint8_t *)v + 4 * k, 4);
+        for (int i = 0; i < g_code[site[k]].n; i++) if (g_code[site[k]].word[i] == w) on = w;
+        __atomic_store_n(&g_code[site[k]].on, on, __ATOMIC_RELAXED);
+    }
+    return true;
+}
+uint32_t cheat_code_word(uint64_t a) {
+    int s = site_find(a, false);
+    return s < 0 ? CHEAT_CODE_ORIGINAL : __atomic_load_n(&g_code[s].on, __ATOMIC_RELAXED);
+}
+
 // ---- the player's cheat files
 static char *slurp(const char *path, size_t *n) {
     FILE *f = fopen(path, "rb");
@@ -438,6 +516,67 @@ static bool is_build_id_name(const char *base, size_t len) {  // "0123456789ABCD
     return true;
 }
 
+bool cheats_main_code(const char *exefs, uint64_t *lo, uint64_t *hi) {  // (NSO header: text memory offset +0x14, size +0x18)
+    char p[PATH_MAX];
+    snprintf(p, sizeof p, "%s/main", exefs);
+    FILE *f = fopen(p, "rb");
+    if (!f) return false;
+    uint8_t h[0x1C];
+    bool ok = fread(h, 1, sizeof h, f) == sizeof h && !memcmp(h, "NSO0", 4);
+    fclose(f);
+    if (!ok) return false;
+    uint32_t off, size;
+    memcpy(&off, h + 0x14, 4), memcpy(&size, h + 0x18, 4);
+    *lo = off, *hi = (uint64_t)off + size;
+    return true;
+}
+
+bool cheats_variants_path(const char *exefs, char *out, size_t n) { return cheat_path(exefs, ".variants.json", out, n, false); }
+
+static bool write_variants(const char *exefs, const char *text) {
+    CheatList l;
+    uint64_t lo = 0, hi = 0;
+    char p[PATH_MAX];
+    if (!cheat_path(exefs, ".variants.json", p, sizeof p, true)) return false;
+    enum { MAXV = 4096 };
+    CheatVariant *v = malloc(MAXV * sizeof *v);
+    int n = 0;
+    if (v && cheats_main_code(exefs, &lo, &hi) && cheats_parse(text, &l)) n = cheats_code_variants(&l, lo, hi, v, MAXV), cheats_free(&l);
+    if (n == 0) {  // (no code cheats: no list - nothing for the game code to be rebuilt for)
+        free(v);
+        return remove(p) == 0 || errno == ENOENT;
+    }
+    size_t cap = 64 + (size_t)n * 40, k = 0;
+    char *j = malloc(cap);
+    if (!j) { free(v); return false; }
+    k += (size_t)snprintf(j + k, cap - k, "{\"code\": {");
+    for (int i = 0; i < n; i++) {
+        bool first = true;
+        for (int q = 0; q < i && first; q++) first = v[q].off != v[i].off;  // (each address once, with all its words)
+        if (!first) continue;
+        k += (size_t)snprintf(j + k, cap - k, "%s\"0x%llx\": [", k > 10 ? ", " : "", (unsigned long long)v[i].off);
+        for (int q = i, m = 0; q < n; q++)
+            if (v[q].off == v[i].off) k += (size_t)snprintf(j + k, cap - k, "%s\"0x%08x\"", m++ ? ", " : "", v[q].word);
+        k += (size_t)snprintf(j + k, cap - k, "]");
+    }
+    k += (size_t)snprintf(j + k, cap - k, "}}\n");
+    bool ok = write_atomic(p, j, k);
+    free(j), free(v);
+    return ok;
+}
+
+bool cheats_variants_hash(const char *exefs, char out[17]) {
+    char p[PATH_MAX];
+    size_t n;
+    char *d = cheats_variants_path(exefs, p, sizeof p) ? slurp(p, &n) : NULL;
+    if (!d) return false;
+    uint64_t h = 0xcbf29ce484222325ull;
+    for (size_t i = 0; i < n; i++) h = (h ^ (uint8_t)d[i]) * 0x100000001b3ull;
+    free(d);
+    snprintf(out, 17, "%016llx", (unsigned long long)h);
+    return true;
+}
+
 bool cheats_import(const char *path, const char *exefs, char *why, size_t why_size) {
     char bid[17], dst[PATH_MAX];
     if (why_size) why[0] = 0;
@@ -494,6 +633,7 @@ bool cheats_import(const char *path, const char *exefs, char *why, size_t why_si
     cheats_free(&l);
     bool ok = cheat_path(exefs, ".txt", dst, sizeof dst, true) && write_atomic(dst, text, strlen(text));
     if (!ok) snprintf(why, why_size, "Couldn't save the cheats in the data folder.");
+    if (ok && !write_variants(exefs, text)) ok = false, snprintf(why, why_size, "Couldn't save the code cheats' list in the data folder.");
     free(text);
     return ok;
 }
@@ -562,3 +702,47 @@ bool cheats_any_on(const char *exefs) {
     free(t);
     return any;
 }
+
+int cheats_code_load(const char *exefs, const char *list_path, uint64_t main_base) {
+    cheat_code_reset();
+    char want[17];
+    FILE *f = fopen(list_path, "r");
+    if (!f) return -1;
+    char have[64] = "";
+    int n = 0;
+    if (fscanf(f, "hash %63s", have) != 1 || !cheats_variants_hash(exefs, want) || strcmp(have, want)) n = -1;
+    unsigned long long off;
+    unsigned word;
+    while (n >= 0 && fscanf(f, " %llx %x", &off, &word) == 2)
+        if (cheat_code_add(main_base + off, (uint32_t)word)) n++;
+    fclose(f);
+    return n;
+}
+
+bool cheat_code_supported(const Cheat *c, uint64_t main_base, uint64_t code_lo, uint64_t code_hi) {
+    CheatList one = {(Cheat *)c, 1};
+    CheatVariant v[64];
+    int n = cheats_code_variants(&one, code_lo, code_hi, v, 64);
+    for (int i = 0; i < n; i++) {
+        int s = site_find(main_base + v[i].off, false);
+        if (s < 0) return false;
+        bool have = false;
+        for (int k = 0; k < g_code[s].n && !have; k++) have = g_code[s].word[k] == v[i].word;
+        if (!have) return false;
+    }
+    return true;
+}
+
+bool cheats_prepare(const char *exefs) {
+    char txt[PATH_MAX], var[PATH_MAX];
+    struct stat t, v;
+    if (!cheat_path(exefs, ".txt", txt, sizeof txt, false) || stat(txt, &t) != 0) return true;  // (no cheats: nothing to do)
+    if (cheats_variants_path(exefs, var, sizeof var) && stat(var, &v) == 0 &&
+        v.st_mtime >= t.st_mtime)  // (st_mtime: Windows' C runtime has no nanoseconds)
+        return true;  // (up to date)
+    char *text = slurp(txt, NULL);
+    if (!text) return false;
+    bool ok = write_variants(exefs, text);
+    free(text);
+    return ok;
+}
diff --git a/runtime/cheats.h b/runtime/cheats.h
index 5cfa7fa..7a29afa 100644
--- a/runtime/cheats.h
+++ b/runtime/cheats.h
@@ -34,6 +34,9 @@ typedef struct {
     uint64_t keys;  // the buttons held, in HID bit order (A = 1 << 0, B = 1 << 1, ... ZL = 1 << 8, ...)
     bool (*readable)(uint64_t addr, uint64_t n);
     bool (*writable)(uint64_t addr, uint64_t n);
+    // a write the VM can't make to memory (main's code): true when it was taken instead - a code cheat's variant
+    // switched on (patches/0010). NULL: refused, as any other.
+    bool (*code_write)(uint64_t addr, const void *v, unsigned n);
 } CheatEnv;
 
 typedef struct {
@@ -69,3 +72,34 @@ bool cheats_is_on(const char *exefs, const char *name);
 void cheats_set_on(const char *exefs, const char *name, bool on);
 void cheats_all_off(const char *exefs);
 bool cheats_any_on(const char *exefs);
+
+// ---- code cheats (patches/0010). The game's code is recompiled, so a cheat that rewrites an instruction can't change
+// it in memory. Instead every fixed instruction write in the imported file (any cheat, on or off) is a *variant*: the
+// generator compiles it next to the original instruction (tools/gen.py --code-variants, which picks the word on at run
+// time with rando_word), and the cheat VM's write into main's code switches that variant on (cheat_code_write).
+typedef struct {
+    uint64_t off;   // from main's base
+    uint32_t word;  // the instruction written there
+} CheatVariant;
+#define CHEAT_CODE_ORIGINAL 0xFFFFFFFFu  // (cheat_code_word: no variant on - the game's own instruction)
+// main's code (its NSO text segment) as offsets from its base
+bool cheats_main_code(const char *exefs, uint64_t *lo, uint64_t *hi);
+// every distinct (offset, word) a cheat writes into [code_lo, code_hi) at a fixed address, 4 or 8 bytes at a time
+int cheats_code_variants(const CheatList *l, uint64_t code_lo, uint64_t code_hi, CheatVariant *out, int max);
+// <data>/cheats/<build id>.variants.json (written by cheats_import): {"code": {"0x<off>": ["0x<word>", ...]}}
+bool cheats_variants_path(const char *exefs, char *out, size_t n);
+bool cheats_variants_hash(const char *exefs, char out[17]);  // of that file (FNV-1a 64, hex); false: none
+// the variants compiled into the running game code, and which one is on at each address (guest addresses)
+void cheat_code_reset(void);
+bool cheat_code_add(uint64_t addr, uint32_t word);
+bool cheat_code_write(uint64_t addr, const void *v, unsigned n);  // false: not all of it is a variant site
+uint32_t cheat_code_word(uint64_t addr);                          // the word on there, or CHEAT_CODE_ORIGINAL
+// The list the game code was built with (runtime/gamebuild.c: <game dir>/lasgame.so.variants - "hash <h>", then
+// "0x<off> 0x<word>" lines): into the table at main_base + off, if <h> is this cheat file's variants hash. Returns
+// the variants loaded, -1 when the list is missing or for another cheat file (the table then empty).
+int cheats_code_load(const char *exefs, const char *list_path, uint64_t main_base);
+// every instruction the cheat writes into main's code [code_lo, code_hi) is compiled in (a cheat with none: true)
+bool cheat_code_supported(const Cheat *c, uint64_t main_base, uint64_t code_lo, uint64_t code_hi);
+// The variants list made again when the cheat file is newer than it (or it is missing): a cheat file copied into
+// <data>/cheats by hand or by the AppImage (its bundled one) gets its code cheats too. false: couldn't write it.
+bool cheats_prepare(const char *exefs);
