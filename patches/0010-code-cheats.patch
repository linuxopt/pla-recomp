+def load_code_variants(m, path):
+    """The code cheats' instruction words (--code-variants) into RANDO_CODE, each one checked first: an address outside
+    the module's code or a word the lifter can't translate is left out (and said), so one odd cheat can't stop the
+    game code from being built. Returns the (offset, word) pairs kept."""
+    kept, skipped = [], 0
+    try:
+        code = _json.load(open(path))['code']
+    except (OSError, ValueError, KeyError) as e:
+        print(f'{m.name}: code variants: {path} unreadable ({e}): none', file=sys.stderr)
+        return kept
+    for off_s, words in code.items():
+        off = int(off_s, 16)
+        a = m.base + off
+        if not (m.lo <= a < m.hi) or a % 4:
+            skipped += len(words)
+            continue
+        ok = []
+        for w_s in words:
+            w = int(w_s, 16)
+            try:
+                m.lifter.lift(w, a)
+            except Exception as e:  # (Unsupported, or a decode the lifter doesn't expect)
+                print(f'{m.name}: code variant {a:#x} = {w:#010x} left out: {e}', file=sys.stderr)
+                skipped += 1
+                continue
+            ok.append(w)
+            kept.append((off, w))
+        if ok:
+            RANDO_CODE[off] = ok
+    print(f'{m.name}: {len(kept)} code variants at {len(RANDO_CODE)} addresses, {skipped} left out', file=sys.stderr)
+    return kept
+
