@@ -509,6 +520,19 @@ bool gamebuild_run(const char *game_dir, const GameBuildOpts *o, char *why, size
             ok = false;
         }
         if (f) fclose(f);
+        // which code cheats it was built with: their hash, then what the generator compiled in (gen.py's list)
+        char vl[1100], vok[1100];
+        snprintf(vl, sizeof vl, "%s.variants", lib);
+        snprintf(vok, sizeof vok, "%s" SEP "main" SEP "code_variants_ok.txt", work);
+        FILE *o = ok ? fopen(vl, "wb") : NULL, *in = variants ? fopen(vok, "rb") : NULL;
+        if (o) {
+            fprintf(o, "hash %s\n", variants ? vhash : "none");
+            char buf[4096];
+            size_t k;
+            while (in && (k = fread(buf, 1, sizeof buf, in)) > 0) fwrite(buf, 1, k, o);
+            fclose(o);
+        }
+        if (in) fclose(in);
     }
     free(units.u);
     rt_remove_game_file(game_dir, ".gamebuild");  // the C, the objects, the logs
diff --git a/runtime/gamesetup.c b/runtime/gamesetup.c
index db718e4..60a15f8 100644
--- a/runtime/gamesetup.c
+++ b/runtime/gamesetup.c
@@ -16,6 +16,7 @@
 #include <string.h>
 #include <sys/stat.h>
 
+#include "cheats.h"
 #include "gamebuild.h"
 #include "gamelib.h"
 #include "hle.h"
@@ -133,8 +134,21 @@ bool setup_ready(void) {
     return game_ok(ROOT "/exefs") && is_file(ROOT "/romfs.bin") && gamelib_present(ROOT);
 }
 
+// The code cheats the game code was built with (runtime/gamebuild.c: lasgame.so.variants' hash) are the imported
+// cheat file's (patches/0010): "none" for both when there are none
+static bool code_cheats_built(void) {
+    char want[17] = "none", have[64] = "none";
+    if (!cheats_variants_hash(ROOT "/exefs", want)) snprintf(want, sizeof want, "none");
+    FILE *f = fopen(ROOT "/" GAMELIB_NAME ".variants", "r");
+    if (f) {
+        if (fscanf(f, "hash %63s", have) != 1) snprintf(have, sizeof have, "?");
+        fclose(f);
+    }
+    return !strcmp(want, have);
+}
+
 bool setup_needs_code(void) {
-    return game_ok(ROOT "/exefs") && is_file(ROOT "/romfs.bin") && !gamelib_present(ROOT);
+    return game_ok(ROOT "/exefs") && is_file(ROOT "/romfs.bin") && (!gamelib_present(ROOT) || !code_cheats_built());
 }
 
 typedef struct { char exefs[1024], romfs[1024], romfs_bin[1024]; bool package; } Found;
