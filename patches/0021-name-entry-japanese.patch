diff --git a/runtime/utf8_text.c b/runtime/utf8_text.c
new file mode 100644
index 0000000..3238f85
--- /dev/null
+++ b/runtime/utf8_text.c
@@ -0,0 +1,89 @@
+// UTF-8 text by characters (see utf8_text.h).
+#include "utf8_text.h"
+
+#include <string.h>
+
+// the length of the well-formed character at s (1-4), 0 if there's none (an end, a bad or cut-short sequence)
+static int char_len(const unsigned char *s, uint32_t *cp) {
+    unsigned c = s[0];
+    int n = c < 0x80 ? 1 : (c & 0xE0) == 0xC0 ? 2 : (c & 0xF0) == 0xE0 ? 3 : (c & 0xF8) == 0xF0 ? 4 : 0;
+    if (!c || !n) return 0;
+    uint32_t v = n == 1 ? c : c & (0x7F >> n);
+    for (int i = 1; i < n; i++) {
+        if ((s[i] & 0xC0) != 0x80) return 0;
+        v = (v << 6) | (s[i] & 0x3F);
+    }
+    static const uint32_t least[] = {0, 0, 0x80, 0x800, 0x10000};
+    if (v < least[n] || v > 0x10FFFF || (v >= 0xD800 && v < 0xE000)) return 0;
+    if (cp) *cp = v;
+    return n;
+}
+
+// the bytes of the character starting at s, skipping over a bad byte as one (for walking text as it is)
+static int step(const char *s) {
+    int n = char_len((const unsigned char *)s, NULL);
+    return n ? n : 1;
+}
+
+int utf8_chars(const char *s) {
+    int n = 0;
+    for (; *s; s += step(s)) n++;
+    return n;
+}
+
+size_t utf8_prefix(const char *s, int n) {
+    const char *p = s;
+    for (; *p && n > 0; n--) p += step(p);
+    return (size_t)(p - s);
+}
+
+void utf8_cut(char *s, int max_chars) { s[utf8_prefix(s, max_chars < 0 ? 0 : max_chars)] = 0; }
+
+void utf8_pop(char *s) {
+    size_t n = strlen(s);
+    if (!n) return;
+    size_t i = n - 1;
+    while (i > 0 && ((unsigned char)s[i] & 0xC0) == 0x80) i--;
+    s[i] = 0;
+}
+
+size_t utf8_fit(const char *s, size_t max_bytes) {
+    size_t k = 0;
+    while (s[k]) {
+        size_t n = (size_t)step(s + k);
+        if (k + n > max_bytes) break;
+        k += n;
+    }
+    return k;
+}
+
+int utf8_append_cp(char *dst, size_t cap, int max_chars, uint32_t cp) {
+    if (cp < 0x20 || cp == 0x7F || (cp >= 0x80 && cp < 0xA0) || cp > 0x10FFFF || (cp >= 0xD800 && cp < 0xE000)) return 0;
+    char b[4];
+    size_t n;
+    if (cp < 0x80) b[0] = (char)cp, n = 1;
+    else if (cp < 0x800) b[0] = (char)(0xC0 | cp >> 6), b[1] = (char)(0x80 | (cp & 0x3F)), n = 2;
+    else if (cp < 0x10000) b[0] = (char)(0xE0 | cp >> 12), b[1] = (char)(0x80 | ((cp >> 6) & 0x3F)), b[2] = (char)(0x80 | (cp & 0x3F)), n = 3;
+    else b[0] = (char)(0xF0 | cp >> 18), b[1] = (char)(0x80 | ((cp >> 12) & 0x3F)), b[2] = (char)(0x80 | ((cp >> 6) & 0x3F)),
+         b[3] = (char)(0x80 | (cp & 0x3F)), n = 4;
+    size_t len = strlen(dst);
+    if (utf8_chars(dst) >= max_chars || len + n + 1 > cap) return 0;
+    memcpy(dst + len, b, n);
+    dst[len + n] = 0;
+    return 1;
+}
+
+int utf8_append(char *dst, size_t cap, int max_chars, const char *src) {
+    int added = 0;
+    const unsigned char *s = (const unsigned char *)src;
+    while (*s) {
+        uint32_t cp;
+        int n = char_len(s, &cp);
+        if (!n) { s++; continue; }  // (not UTF-8: left out)
+        s += n;
+        if (cp < 0x20 || cp == 0x7F || (cp >= 0x80 && cp < 0xA0)) continue;  // (control characters)
+        if (!utf8_append_cp(dst, cap, max_chars, cp)) break;  // (full)
+        added++;
+    }
+    return added;
+}
diff --git a/runtime/utf8_text.h b/runtime/utf8_text.h
new file mode 100644
index 0000000..ad389b9
--- /dev/null
+++ b/runtime/utf8_text.h
@@ -0,0 +1,23 @@
+// UTF-8 text by characters (code points), not bytes: the game's name entry (runtime/ui/menu.mm, runtime/ui/osk.mm)
+// takes Japanese - 3 bytes a character - and must count, cut and delete whole characters.
+#pragma once
+#include <stddef.h>
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+int utf8_chars(const char *s);                    // characters in s
+size_t utf8_prefix(const char *s, int n);         // bytes of its first n characters (all of it if fewer)
+void utf8_cut(char *s, int max_chars);            // keep at most max_chars characters
+void utf8_pop(char *s);                           // drop the last character
