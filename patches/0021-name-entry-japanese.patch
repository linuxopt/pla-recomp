 runtime/ui/osk.h    |  2 +-
 runtime/ui/osk.mm   | 22 ++++++-----
 runtime/utf8_text.c | 89 +++++++++++++++++++++++++++++++++++++++++++
 runtime/utf8_text.h | 23 ++++++++++++
 6 files changed, 212 insertions(+), 23 deletions(-)
 create mode 100644 runtime/utf8_text.c
